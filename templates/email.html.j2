{%- macro impact(n) -%}<span class="{{ 'hi' if n >= 4 else 'm' }}">{{ '■' * n }}{{ '□' * (5 - n) }}</span> {{ n }}/5{%- endmacro -%}
<!doctype html>
<html lang="{{ cfg.language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ cfg.title }} · No. {{ i.number }}</title>
<style>
body{margin:0;padding:0;background:#f6f4ee}
.w{max-width:640px;margin:0 auto;padding:24px 16px;color:#16161a;font:15px/1.55 -apple-system,'Segoe UI',Helvetica,Arial,sans-serif}
.s{font-family:Georgia,'Times New Roman',serif}
.l{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;color:#6b6a66}
.o{color:#4f5d2f}.k{color:#16161a}
.top{border-bottom:1px solid #16161a;padding-bottom:10px}
.h{padding:24px 0 20px;border-bottom:1px solid #d8d3c7}
.t{font-size:30px;line-height:1.12;margin:0 0 10px}
.lead{font-style:italic;font-size:17px;line-height:1.45;color:#3c3b38;margin:0}
.sh{border-bottom:1px solid #16161a;padding:28px 0 8px;font-size:11px;letter-spacing:2px}
.no{font-size:24px;color:#4f5d2f;margin-right:10px;letter-spacing:0}
.b{border-top:1px solid #d8d3c7;padding:8px 0;font-size:16px;line-height:1.4}
.it{padding:16px 0;border-bottom:1px solid #d8d3c7}
.it h3{font-size:19px;line-height:1.25;margin:7px 0 8px;font-weight:400}
.it p{margin:0 0 8px}
.m{color:#16161a;letter-spacing:1px}.hi{color:#4f5d2f;letter-spacing:1px}
.f{font-size:12px;line-height:1.6;color:#6b6a66}
.f b{color:#16161a}
a{color:#4f5d2f}
.it h3 a,.row a{color:#16161a;text-decoration:none}
.row{padding:9px 0;border-bottom:1px solid #d8d3c7;font-size:14px}
.chip{border:1px solid #4f5d2f;padding:1px 4px}
.note{border-left:2px solid #4f5d2f;padding:10px 14px;font-size:14px;color:#3c3b38;margin-top:20px}
.foot{border-top:1px solid #16161a;margin-top:30px;padding-top:12px;font-size:11.5px;line-height:1.6;color:#6b6a66}
</style></head>
<body><div class="w">

<div class="top"><span class="l k">{{ cfg.title }}</span> <span class="l" style="float:right">No. {{ i.number }} · {{ i.date | longdate }}</span></div>

<div class="h">
  <div class="s t">{{ i.title }}</div>
  {% if i.lead %}<p class="s lead">{{ i.lead }}</p>{% endif %}
  {% if site_url %}<p class="l" style="margin:14px 0 0"><a href="{{ site_url }}" style="text-decoration:none">Read on the website &rarr;</a> · PDF available there</p>{% endif %}
</div>

{% if i.overview %}
<div style="padding-top:20px"><div class="l o" style="margin-bottom:8px">In brief</div>
{% for o in i.overview %}<div class="b s"><span class="l o">{{ '%02d' % loop.index }}</span>&nbsp; {{ o.text }}{% if items[o.item] %} <span class="f">· Impact {{ impact(items[o.item].impact) }}</span>{% endif %}</div>
{% endfor %}</div>
{% endif %}

{% for s in i.sections %}
<div class="sh l k"><span class="s no">{{ '%02d' % loop.index }}</span>{{ s.label }}</div>
{% if not s['items'] %}<p class="f">Nothing that clears the bar this time.</p>{% endif %}
{% for it in s['items'] %}
<div class="it">
  <div class="l o">{{ it.kind }} <span class="l">· {{ it.date | shortdate }}</span>{% if it.new_entrant %} <span class="chip">New entrant</span>{% endif %}</div>
  <h3 class="s"><a href="{{ it.source.url }}">{{ it.title }}</a></h3>
  <p>{{ it.summary }}</p>
  <p><b>Why it matters.</b> {{ it.why }}</p>
  <div class="f">Impact {{ impact(it.impact) }} · <b>Credibility: {{ it.credibility }}.</b> {{ it.credibility_note }} · <a href="{{ it.source.url }}">{{ it.source.name }}</a> ({{ it.source.type }}){% for a in it.also or [] %} · <a href="{{ a.url }}">{{ a.name }}</a>{% endfor %}</div>
</div>
{% endfor %}
{% endfor %}

{% if i.competitors %}
<div class="sh l k">Competitor watch</div>
{% for c in i.competitors %}<div class="row"><span class="s" style="font-size:16px">{% if c.url %}<a href="{{ c.url }}">{{ c.company }}</a>{% else %}{{ c.company }}{% endif %}</span>{% if c.new %} <span class="l o">New</span>{% endif %}<br>{{ c.move }}<br><span class="f">{{ c.date | shortdate }} · Impact {{ impact(c.impact) }}</span></div>
{% endfor %}
{% endif %}

{% if i.questions %}
<div class="sh l k">Standing questions: what changed</div>
{% for q in i.questions %}<div class="row"><div class="s" style="font-style:italic;font-size:16px;margin-bottom:4px">{{ q.question }}</div>{{ q['update'] }}</div>
{% endfor %}
{% endif %}

{% if i.coming_up %}
<div class="sh l k">Coming up</div>
{% for c in i.coming_up %}<div class="row"><span class="f">{{ c.date | shortdate }}</span> &nbsp; {% if c.url %}<a href="{{ c.url }}" style="color:#16161a">{{ c.what }}</a>{% else %}{{ c.what }}{% endif %}</div>
{% endfor %}
{% endif %}

{% if i.note %}<div class="note">{{ i.note }}</div>{% endif %}

<div class="foot">
  <b class="k">Impact on the field:</b> 1 minor · 2 noteworthy · 3 significant for a segment · 4 major, shifts direction within a year · 5 field-changing.<br>
  <b class="k">Credibility:</b> High = primary source or several independent reports with numbers; Medium = reputable press, preprint or company claim; Low = single unconfirmed report. Claims are reported as the source states them.
  {% if cfg.motif != 'none' %}<div class="s" style="margin-top:12px;font-style:italic;font-size:14px">ἀλήθεια</div>{% endif %}
</div>

</div></body></html>
