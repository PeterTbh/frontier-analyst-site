<!doctype html>
<html lang="{{ cfg.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.title }} · No. {{ i.number }}</title>
<style>{{ css | safe }}</style>
</head>
{%- macro impact(n) -%}
<span class="impact{% if n >= 4 %} impact--hi{% endif %}" title="Impact {{ n }} of 5"><span>Impact</span>{% for k in range(1, 6) %}<i class="{{ 'on' if k <= n else '' }}"></i>{% endfor %}<span>{{ n }}/5</span></span>
{%- endmacro -%}
{%- macro owl() -%}
<svg class="owl motif" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5 8 7.5h8l3-3V13c0 4.4-3.1 7.5-7 7.5S5 17.4 5 13Z"/><circle cx="9.3" cy="11.4" r="2.1"/><circle cx="14.7" cy="11.4" r="2.1"/><path d="m11.2 14.6.8 1.3.8-1.3"/></svg>
{%- endmacro -%}
<body class="{{ 'no-motif' if cfg.motif == 'none' else '' }}">
<article class="issue">

  <div class="top">
    <span class="top__brand">{{ owl() }}<span class="label" style="color:var(--ink)">{{ cfg.title }}</span></span>
    <span class="label">No. {{ i.number }} &middot; {{ i.date | longdate }}</span>
  </div>

  <header class="head">
    <h1 class="head__title">{{ i.title }}</h1>
    {% if i.lead %}<p class="head__lead">{{ i.lead }}</p>{% endif %}
    <div class="head__meta">
      <span class="label">Covering {{ i.period.from | shortdate }} &ndash; {{ i.period.to | shortdate }}</span>
      <span class="label">{{ n_items }} item{{ '' if n_items == 1 else 's' }} &middot; {{ i.sections | length }} section{{ '' if i.sections|length == 1 else 's' }}</span>
    </div>
  </header>

  {% if i.overview %}
  <section class="brief">
    <span class="label label--olive">In brief</span>
    <ol class="brief__list">
      {% for o in i.overview %}
      <li><a href="#{{ o.item }}">{{ o.text }}</a>{% if items[o.item] %}{{ impact(items[o.item].impact) }}{% endif %}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% for s in i.sections %}
  <section class="section" id="{{ s.id }}">
    <div class="section__head">
      <span class="section__no">{{ '%02d' % loop.index }}</span>
      <h2 class="section__title">{{ s.label }}</h2>
      <span class="label section__count">{{ s['items'] | length }} item{{ '' if s['items']|length == 1 else 's' }}</span>
    </div>
    {% if not s['items'] %}
    <p class="item__summary" style="padding:18px 0;color:var(--muted)">Nothing that clears the bar this time.</p>
    {% endif %}
    {% for it in s['items'] %}
    <div class="item" id="{{ it.id }}">
      <div class="item__side">
        <span class="label label--olive">{{ it.kind }}</span>
        <span class="label">{{ it.date | shortdate }}</span>
        {% if it.new_entrant %}<span><span class="chip">New entrant</span></span>{% endif %}
      </div>
      <div>
        <h3 class="item__title"><a href="{{ it.source.url }}" target="_blank" rel="noopener">{{ it.title }}</a></h3>
        <p class="item__summary">{{ it.summary }}</p>
        <p class="item__why"><b>Why it matters.</b> {{ it.why }}</p>
        <div class="item__foot">
          {{ impact(it.impact) }}
          <span><b>Credibility: {{ it.credibility }}.</b> {{ it.credibility_note }}</span>
          <span><a href="{{ it.source.url }}" target="_blank" rel="noopener">{{ it.source.name }}</a> &middot; {{ it.source.type }}{% for a in it.also or [] %} &middot; <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.name }}</a>{% endfor %}</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  {% if i.competitors %}
  <section class="section" id="competitors">
    <div class="section__head">
      <span class="section__no">{{ '%02d' % (i.sections|length + 1) }}</span>
      <h2 class="section__title">Competitor watch</h2>
    </div>
    <table class="ledger">
      <thead><tr><th class="label">Company</th><th class="label">Move</th><th class="label">Date</th><th class="label">Impact</th></tr></thead>
      <tbody>
      {% for c in i.competitors %}
        <tr>
          <td class="co">{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.company }}</a>{% else %}{{ c.company }}{% endif %}{% if c.new %}<br><span class="chip">New</span>{% endif %}</td>
          <td>{{ c.move }}</td>
          <td class="date">{{ c.date | shortdate }}</td>
          <td>{{ impact(c.impact) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if i.questions %}
  <section class="section" id="questions">
    <div class="section__head">
      <span class="section__no">{{ '%02d' % (i.sections|length + (2 if i.competitors else 1)) }}</span>
      <h2 class="section__title">Standing questions: what changed</h2>
    </div>
    <ul class="qs">
      {% for q in i.questions %}<li><q>{{ q.question }}</q><span>{{ q['update'] }}</span></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if i.coming_up %}
  <section class="section" id="coming-up">
    <div class="section__head">
      <span class="section__no">&rarr;</span>
      <h2 class="section__title">Coming up</h2>
    </div>
    <table class="ledger">
      <tbody>
      {% for c in i.coming_up %}
        <tr><td class="date" style="width:110px">{{ c.date | shortdate }}</td><td>{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.what }}</a>{% else %}{{ c.what }}{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if i.note %}<p class="note">{{ i.note }}</p>{% endif %}

  <footer class="foot">
    <div>
      <span class="label">Impact on the field</span>
      <p>1 minor &middot; 2 noteworthy &middot; 3 significant for a segment &middot; 4 major, shifts direction within a year &middot; 5 field-changing.</p>
    </div>
    <div>
      <span class="label">Credibility</span>
      <p>High: primary source or several independent reports with numbers. Medium: reputable press, preprint or company claim. Low: single unconfirmed report. Claims are reported as the source states them.</p>
    </div>
    <div class="foot__sign">{{ owl() }}<span class="label">{{ cfg.title }} &middot; No. {{ i.number }}</span><span class="greek motif" lang="grc">ἀλήθεια</span></div>
  </footer>
</article>
</body>
</html>
